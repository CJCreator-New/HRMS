# ==============================================================================
# Enterprise HRMS (v2.7) — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
#
# There are two primary local development modes:
#
# 1. RAPID MOCK MODE (Zero PostgreSQL Setup Required):
#    Set NEXT_PUBLIC_MOCK_AUTH=true. The app will simulate authenticated personas
#    (System Admin, HR Admin, Manager, Employee, etc.) via signed dev cookies.
#
# 2. FULL-STACK POSTGRES / SUPABASE MODE:
#    Set NEXT_PUBLIC_MOCK_AUTH=false and provide Supabase / PostgreSQL credentials.
# ==============================================================================

# ==============================================================================
# 1. Supabase / PostgreSQL Configuration
# ==============================================================================
# Public API URL of your local Supabase instance (or hosted project)
# Local default: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Public Anonymous API Key (safe for browser client-side usage)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Secret Service Role Key (Server-only — used by server actions & E2E test runner)
# WARNING: NEVER expose this key to client-side code or public repositories.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ==============================================================================
# 2. Application & Authentication Modes
# ==============================================================================
# Mock Auth Mode:
#   - "true": Bypasses real Supabase Auth; enables Persona Switcher UI and mock cookies.
#   - "false": Enforces live Supabase Auth with email/password authentication & RLS.
NEXT_PUBLIC_MOCK_AUTH=false

# Canonical Base URL of the Application
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret key used for signing & verifying mock session cookies in development
# Optional: falls back to SUPABASE_SERVICE_ROLE_KEY or a default dev key if omitted
MOCK_COOKIE_SECRET=your-mock-cookie-signing-secret

# ==============================================================================
# 3. Distributed Rate Limiting (Required in Production — Upstash Redis)
# ==============================================================================
# In production, UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN are strictly required
# for distributed sliding-window rate limiting across serverless/container instances.
# In local development / test, leave empty to automatically use in-memory rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ==============================================================================
# 4. End-to-End Testing (Playwright)
# ==============================================================================
# Target base URL for Playwright E2E test runs
PLAYWRIGHT_TEST_BASE_URL=http://localhost:3000